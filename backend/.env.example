# Copy this file to .env and fill in the values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Neon Postgres). Leave blank locally to boot without a DB (/health -> db:false).
DATABASE_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# External football data (API-Football v3)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Requests/minute your plan allows: free 10, Pro ~300. Stay UNDER the ceiling —
# the deployed app and a local script can be spending it at the same time, and
# aiming exactly at the limit is how a sweep loses requests to HTTP 429.
API_FOOTBALL_RPM=240
# Requests/DAY your plan allows — a hard ceiling the app refuses to cross
# (free = 100, Pro = 7500; resets ~00:00 UTC).
API_FOOTBALL_DAILY_LIMIT=7500

# Compute league tables and scorer leaderboards from stored results instead of
# fetching them. ON only for the FREE plan, which refuses `standings` and
# `topscorers` for the current season. On a paid plan leave it OFF — the fetched
# table knows about point deductions a rebuild cannot, and the rebuild would
# silently overwrite it.
DERIVE_FROM_RESULTS=

# Protects /admin/sync/* endpoints when triggered from outside (cron-job.org etc.)
SYNC_SECRET=change-me

# Platform admins (the app owner). Comma-separated emails that get the /admin
# panel and can promote other admins. Set this to YOUR account email before
# going live, or nobody can reach the admin panel.
ADMIN_EMAILS=

# CORS: comma-separated allowed origins, or * for any (dev only). In production
# set this to your frontend origin, e.g. https://extratime.vercel.app
CORS_ORIGIN=*
